# Quarto documentation build output (see _quarto.yml, render.sh)
/_book/
# exporting.qmd writes these at render time. They are build output, not source.
/outputs/
/.quarto/
.quarto-preview.log
.quarto-preview.err
# /_freeze/ is intentionally tracked: it holds the executed cell outputs.

# Render environment
.venv/

# OS / editor cruft
.DS_Store
Thumbs.db
__pycache__/
.ipynb_checkpoints/

# Quarto intermediate notebooks
*.quarto_ipynb

# Single-file renders (./render.sh <file>) write output next to the source
chapters/**/*.html
chapters/**/*_files/
